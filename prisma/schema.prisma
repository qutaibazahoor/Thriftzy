generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  brand         String
  category      String   // sneakers, loafers, boots
  size          String
  price         Int
  originalPrice Int?
  condition     String   // Excellent, Very Good, Good
  image         String
  images        String?  // JSON array as string
  description   String
  isFeatured    Boolean  @default(false)
  isSold        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  CartItem      CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  sessionId String   // To track cart items by browser session
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Order {
  id           String   @id @default(uuid())
  customerName String
  email        String
  phone        String
  address      String
  items        String   // JSON array as string
  total        Int
  status       String   @default("pending") // pending, confirmed, shipped, delivered
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
